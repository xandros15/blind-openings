{
    auto_https off
}

:80 {
    log {
        output stdout
        format console
    }

    handle_path /api/* {
        root * /app/public
        try_files {path} /index.php
        php_fastcgi panel-php:9000
    }

    handle_path /videos/* {
        root /videos
        @assets path *.webp
        header @assets expires 14d
        file_server browse
    }

    handle {
        root * /app
        try_files {path} /index.html
        file_server
    }
}
